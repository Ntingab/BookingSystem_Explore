{
  "ConnectionStrings": {
    "DefaultConnection": "Server=JHB-BASIL\\SQLEXPRESS01;Database=BookingSystem;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True;"
  },
  "RateLimiter": {
    "TokenLimit": 20,
    "TokensPerPeriod": 20,
    "ReplenishmentMinutes": 1,
    "QueueLimit": 0
  },
  "FeatureFlags": {
    "EnableStrictCors": false,
    "EnableHsts": true
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:5001"]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "Logs/log-.txt", "rollingInterval": "Day" } },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
