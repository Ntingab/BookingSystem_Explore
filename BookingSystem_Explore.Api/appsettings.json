{
  "ConnectionStrings": {
    "DefaultConnection": "Server=JHB-BASIL\\SQLEXPRESS01;Database=BookingSystem;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True;"
  },
  "RateLimiter": {
    "TokenLimit": 20,
    "TokensPerPeriod": 20,
    "ReplenishmentMinutes": 1,
    "QueueLimit": 0
  },
  "FeatureFlags": {
    "EnableStrictCors": false,
    "EnableHsts": true
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:5001", "https://localhost:7025"]
  },
  "Security": {
    "PhoneEncryption": {
      "Key": "Change-This-Phone-Encryption-Key"
    }
  },
  "ClientAccess": {
    "RequireClientCertificate": false,
    "Jwt": {
      "Issuer": "BookingSystem_Explore.Ui",
      "Audience": "BookingSystem_Explore.Api",
      "SigningKey": "Change-This-Jwt-Signing-Key-AtLeast-32-Bytes-Long-123456",
      "ExpiryMinutes": 30
    },
    "Clients": [
      {
        "ClientId": "booking-ui",
        "ClientSecret": "Change-This-Client-Secret",
        "Scopes": ["read", "write"],
        "AllowedCertificateThumbprints": [],
        "RateLimit": {
          "TokenLimit": 40,
          "TokensPerPeriod": 40,
          "ReplenishmentMinutes": 1,
          "QueueLimit": 0
        }
      }
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "../Logs/log-.txt", "rollingInterval": "Day" } },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
